{%- from "moj/components/filter/macro.njk" import mojFilter -%}
{%- from "govuk/components/select/macro.njk" import govukSelect -%}

{% macro getFilterOptionHTML(filters) %}
    {%- set caseReferenceItems = [
        {
            value: "none",
            text: "No case reference",
            selected: ("none" in filters.byCaseReferences)
        }
    ] -%}

    {%- for caseReference in filters.facets['caseReferences'].values -%}
        {%- set caseReferenceItems = (caseReferenceItems.push({
            value: caseReference.value,
            text: caseReference.value,
            selected: (caseReference.value in filters.byCaseReferences)
        }), caseReferenceItems) -%}
    {%- endfor -%}

    {{ govukSelect({
        id: "byCaseReferenceAutocomplete",
        name: "byCaseReference",
        label: {
          text: "Case reference",
          isPageHeading: true,
          classes: "govuk-fieldset__legend--m"
        },
        hint: {
          text: "Search for a case reference"
        },
        items: caseReferenceItems,
        classes: "js-autocomplete-select",
        attributes: {
          "data-test": "select-autocomplete-input",
          "data-input-classes": "govuk-input--width-10",
          "data-menu-classes": "govuk-input--width-10",
          "multiple": "multiple",
          "data-placeholder": "All case references"
        }
      }) }}

{% endmacro %}

{%- set caseReferenceRemoveFilters = [] %}

{%- for caseReference in filters.byCaseReferences -%}
    {%- set caseReferenceRemoveFilters = (caseReferenceRemoveFilters.push({
        text: "All case references" if (caseReference === "all") else ("No case reference" if (caseReference === "none") else caseReference),
        href: filters.removeFilterLink.caseReferences[caseReference]
    }), caseReferenceRemoveFilters) -%}
{%- endfor -%}

{%- set selectedFilterCategory = {
    heading: {
        text: 'Case reference'
    },
    items: caseReferenceRemoveFilters
} -%}
