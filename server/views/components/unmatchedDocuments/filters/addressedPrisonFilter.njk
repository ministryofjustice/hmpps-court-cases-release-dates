{%- from "moj/components/filter/macro.njk" import mojFilter -%}
{%- from "govuk/components/checkboxes/macro.njk" import govukCheckboxes -%}

{% macro getFilterOptionHTML(filters) %}
    {%- set addressedPrisonItems = [
        {
            value: "all",
            text: "All addressees",
            checked: ("all" in filters.byAddressedPrisons),
            behaviour: "exclusive"
        }
    ] -%}

    {%- for addressedPrison in filters.facets['addressedPrison'].values -%}
        {% if addressedPrison.value == null %}
            {%- set addressedPrisonItems = (addressedPrisonItems.push({
                value: "none",
                text: "Not available" + " (" + addressedPrison.count + ")",
                checked: ("none" in filters.byAddressedPrisons),
                behaviour: "exclusive"
            }), addressedPrisonItems) -%}

            {% if filters.facets['addressedPrison'].values.length > 1 %}
                {%- set addressedPrisonItems = (addressedPrisonItems.push({
                    divider: "or"
                }), addressedPrisonItems) -%}
            {% endif %}
        {% else %}
            {%- set addressedPrisonItems = (addressedPrisonItems.push({
                value: addressedPrison.value,
                text: addressedPrison.value + " (" + addressedPrison.count + ")",
                checked: (addressedPrison.value in filters.byAddressedPrisons)
            }), addressedPrisonItems) -%}
        {% endif %}
    {%- endfor -%}

    {{ govukCheckboxes({
        name: "byAddressedPrison",
        classes: "govuk-checkboxes--small",
        fieldset: {
            legend: {
                text: "Addressed to",
                classes: "govuk-fieldset__legend--m"
            }
        },
        items: addressedPrisonItems
    }) }}
{% endmacro %}

{%- set addressedPrisonRemoveFilters = [] %}

{%- for addressedPrison in filters.byAddressedPrisons -%}
    {%- set addressedPrisonRemoveFilters = (addressedPrisonRemoveFilters.push({
        text: "All addressees" if (addressedPrison === "all") else ("Not available" if (addressedPrison === "none") else addressedPrison),
        href: filters.removeFilterLink.addressedPrisons[addressedPrison]
    }), addressedPrisonRemoveFilters) -%}
{%- endfor -%}

{%- set selectedFilterCategory = {
    heading: {
        text: 'Addressed to'
    },
    items: addressedPrisonRemoveFilters
} -%}
