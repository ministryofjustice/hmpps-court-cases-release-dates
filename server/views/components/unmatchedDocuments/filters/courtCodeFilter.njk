{%- from "moj/components/filter/macro.njk" import mojFilter -%}
{%- from "govuk/components/select/macro.njk" import govukSelect -%}

{% macro getFilterOptionHTML(filters) %}
    {%- set courtCodeItems = [] -%}

    {%- for courtCode in filters.facets['courtCode'].values -%}
        {% if courtCode.value == null %}
            {%- set courtCodeItems = (courtCodeItems.push({
                value: "none",
                text: "Not entered",
                selected: ("none" in filters.byCourtCodes)
            }), courtCodeItems) -%}
        {% else %}
            {%- set courtCodeItems = (courtCodeItems.push({
                value: courtCode.value,
                text: courtCode.description + " (" + courtCode.value + ")",
                selected: (courtCode.value in filters.byCourtCodes)
            }), courtCodeItems) -%}
        {% endif %}
    {%- endfor -%}

    {{ govukSelect({
        id: "byCourtCodeAutocomplete",
        name: "byCourtCode",
        label: {
          text: "Court",
          isPageHeading: true,
          classes: "govuk-fieldset__legend--m"
        },
        hint: {
          text: "Search for a court"
        },
        items: courtCodeItems,
        classes: "js-autocomplete-select",
        attributes: {
          "data-test": "select-autocomplete-input",
          "data-input-classes": "govuk-input--width-10",
          "data-menu-classes": "govuk-input--width-10",
          "multiple": "multiple",
          "data-placeholder": "All courts"
        }
      }) }}

{% endmacro %}

{%- set courtCodeRemoveFilters = [] %}

{%- for courtCode in filters.byCourtCodes -%}
    {%- set courtCodeRemoveFilters = (courtCodeRemoveFilters.push({
        text: "All courts" if (courtCode === "all") else ("Not entered" if (courtCode === "none") else courtCode),
        href: filters.removeFilterLink.courtCodes[courtCode]
    }), courtCodeRemoveFilters) -%}
{%- endfor -%}

{%- set selectedFilterCategory = {
    heading: {
        text: 'Court'
    },
    items: courtCodeRemoveFilters
} -%}
