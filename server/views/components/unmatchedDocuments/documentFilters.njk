{%- from "moj/components/filter/macro.njk" import mojFilter -%}
{% from "components/prisoner/filters/showingFilter.njk"
    import getFilterOptionHTML as getShowingFilterOption ,
           selectedFilterCategory as showingSelectedFilterCategory
    with context %}
{% from "components/prisoner/filters/caseReferencesFilter.njk"
    import getFilterOptionHTML as getCaseReferencesFilterOption ,
           selectedFilterCategory as caseReferenceSelectedFilterCategory
    with context %}
{% from "components/unmatchedDocuments/filters/addressedPrisonFilter.njk"
    import getFilterOptionHTML as getAddressedPrisonFilterOption ,
           selectedFilterCategory as addressedPrisonSelectedFilterCategory
    with context %}


{%- set filterOptionsHtml %}
    {{ getShowingFilterOption(filters) }}
    {{ getCaseReferencesFilterOption(filters) }}
    {{ getAddressedPrisonFilterOption(filters) }}
{% endset -%}

{%- set selectedFilterCategories = [
    showingSelectedFilterCategory,
    caseReferenceSelectedFilterCategory,
    addressedPrisonSelectedFilterCategory
] -%}

<div class="moj-filter-layout__filter">
<form id="documentFiltersForm" action="{{filters.baseUrlLink}}" method="GET">
    {{ mojFilter({
    heading: {
        text: "Filter"
    },

    submit: {
        attributes: {
            "data-test-id": "submit-button"
        }
    },

    selectedFilters: {
        heading: {
            text: "Selected filters"
        },
        clearLink: {
            text: "Clear filters",
            href: filters.baseUrlLink
        },

        categories: selectedFilterCategories
    },

    optionsHtml: filterOptionsHtml
    }) }}

    <input type="hidden" name="sortBy" value="{{ filters.pagination.sortBy }}" />
</form>
</div>
