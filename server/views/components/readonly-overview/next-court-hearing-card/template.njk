{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% if nextCourtAppearance %}
    {{ govukSummaryList({
        rows: [
            {
                key: {
                text: "Case reference"
            },
                value: {
                text: nextCourtAppearance.caseReference or 'Not entered'
            }
            },
            {
                key: {
                text: "Location"
            },
                value: {
                text: courtName
            }
            },
            {
                key: {
                text: "Hearing type"
            },
                value: {
                html: nextCourtAppearance.courtAppearanceSubType.description if nextCourtAppearance.courtAppearanceSubType else nextCourtAppearance.appearanceType.description
            }
            },
            {
                key: {
                text: "Date"
            },
                value: {
                text: nextCourtAppearance.dateTime | dateTime
            }
            }
        ]
    }) }}
{% else %}
    <p class="govuk-body">There are no upcoming court hearings</p>
{% endif %}
