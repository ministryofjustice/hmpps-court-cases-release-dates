{% extends "../../partials/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{% set pageTitle = applicationName + " - Check the mapping" %}
{% set pageId = "document-delivery-confirm" %}

{% set changeHref = "/document-delivery/classify?email=" + (preview.emailAddress | urlencode) %}

{% block beforeContent %}
  {{ govukBackLink({ text: "Back", href: changeHref }) }}
{% endblock %}

{% block content %}

  <div class="govuk-grid-row govuk-!-padding-top-4">
    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-l">Check the mapping before you create it</h1>

      {{ govukSummaryList({
        rows: [
          {
            key: { text: "Addressed to" },
            value: { html: '<span class="govuk-!-font-family-monospace">' + preview.emailAddress + '</span>' }
          },
          {
            key: { text: "Category" },
            value: { text: preview.category.name },
            actions: { items: [{ href: changeHref, text: "Change", visuallyHiddenText: "category" }] }
          },
          {
            key: { text: "Prison" },
            value: { text: preview.prisonCode },
            actions: { items: [{ href: changeHref, text: "Change", visuallyHiddenText: "prison" }] }
          }
        ],
        attributes: { "data-qa": "preview" }
      }) }}

      {% set warningHtml %}
        Documents already received from this address are recorded as delivered to
        {{ preview.prisonCode }} when the re-resolution backfill is next run, not just future traffic.
        {% if preview.replacesExisting %}This also replaces the mapping this address already has.{% endif %}
      {% endset %}
      {{ govukWarningText({ html: warningHtml, iconFallbackText: "Warning", attributes: { "data-qa": "blast-radius" } }) }}

      <p class="govuk-body">
        If this address serves a hub rather than a single prison, recording it against one prison would be
        wrong. Each document still reaches whoever holds the person.
      </p>

      <form method="post" action="/document-delivery/confirm" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <input type="hidden" name="emailAddress" value="{{ preview.emailAddress }}" />
        <input type="hidden" name="categoryCode" value="{{ preview.category.code }}" />
        <input type="hidden" name="prisonCode" value="{{ preview.prisonCode }}" />

        <div class="govuk-button-group">
          {{ govukButton({ text: "Save mapping", preventDoubleClick: true, attributes: { "data-qa": "confirm" } }) }}
          <a class="govuk-link" href="/document-delivery">Cancel</a>
        </div>
      </form>

    </div>
  </div>

{% endblock %}
